diff --git a/Verbose/Infrastructure/HelpInfrastructure.lean b/Verbose/Infrastructure/HelpInfrastructure.lean
index cb8aab4..af7959f 100644
--- a/Verbose/Infrastructure/HelpInfrastructure.lean
+++ b/Verbose/Infrastructure/HelpInfrastructure.lean
@@ -42,17 +42,31 @@ def Lean.Expr.relSymb : Expr → Option String
 | .const ``HasSubset.Subset _ => pure " ⊆ "
 | _ => none
 
+/-- Whether `e` is an order relation (`≤`, `<`, `≥`, `>`) on a type Mathlib writes with set
+notation. Since Mathlib v4.34 (`Mathlib.Tactic.SetNotationForOrder`), `s ⊆ t` elaborates to
+`s ≤ t` on such types (`Set`, `Finset`, …) and only prints as `s ⊆ t`; the types are the ones
+with a `UsesSetNotationForOrder` instance. -/
+def Lean.Expr.usesSetNotation (e : Expr) : MetaM Bool := do
+  unless e.getAppNumArgs == 4 && (e.isAppOf ``LE.le || e.isAppOf ``LT.lt || e.isAppOf ``GE.ge || e.isAppOf ``GT.gt) do
+    return false
+  let some cls ← observing? (mkAppM ``UsesSetNotationForOrder #[e.getArg! 0]) | return false
+  return (← trySynthInstance cls) matches .some _
+
 /-- Given an expression which is either describing an inequality or subset or membership,
 return a string decribing the relation and the LHS and RHS. -/
 partial def Lean.Expr.relInfo? : Expr → MetaM (Option (String × Expr × Expr))
 | .mvar m => do Lean.Expr.relInfo? (← m.getType'')
-| e@(_) =>  if e.getAppNumArgs < 2 then
+| e@(_) => do
+  if e.getAppNumArgs < 2 then
     return none
-  else
-    return match relSymb e.getAppFn with
-           | some " ∈ " => some (" ∈ ", e.appArg!, e.appFn!.appArg!)
-           | some s => some (s , e.appFn!.appArg!, e.appArg!)
-           | none => none
+  -- `≤` on a set-notation type is `⊆` (see `usesSetNotation`); `<`, `≥` and `>` there are
+  -- `⊂`, `⊇` and `⊃`, which Verbose treated as plain propositions before Mathlib v4.34.
+  if ← e.usesSetNotation then
+    return if e.isAppOf ``LE.le then some (" ⊆ ", e.appFn!.appArg!, e.appArg!) else none
+  return match relSymb e.getAppFn with
+         | some " ∈ " => some (" ∈ ", e.appArg!, e.appFn!.appArg!)
+         | some s => some (s , e.appFn!.appArg!, e.appArg!)
+         | none => none
 
 /-- For testing purposes -/
 elab "#relInfo" t:term: command =>
@@ -221,6 +235,13 @@ partial def parse {α : Type}
       parse e.getAppArgs[0]! fun left ↦ parse e.getAppArgs[1]! fun right ↦ ret <| .iff e e.getAppArgs[0]! e.getAppArgs[1]! left right
     | .const `Eq .. => ret <| .equal e e.getAppArgs[1]! e.getAppArgs[2]!
     | .const `LE.le _ | .const `LT.lt _ | .const `GE.ge _ | .const `GT.gt _ => do
+      if ← e.usesSetNotation then
+        -- `s ⊆ t` on sets and finsets (Mathlib v4.34 elaborates it to `s ≤ t`)
+        if e.isAppOf ``LE.le then
+          let some (_, lhs, rhs) ← e.relInfo? | unreachable!
+          ret <| .subset e lhs rhs
+        else simple e
+      else
       let some (rel, lhs, rhs) ← e.relInfo? | unreachable!
       ret <| .ineq e lhs rel rhs
     | .const `Membership.mem _ => do
@@ -408,7 +429,7 @@ def pushTactic (tac : TSyntax `tactic)  : SuggestionM Unit := do
     throwError "There is already a tactic for this suggestion. You may need to call `flush` first."
   set {s with flushed := false, currentTactic := some tac, currentPre := match s.currentPre with | some c => some s!"{c}\n" | none => none}
 
-macro "pushTac" quoted:term : term => `(do pushTactic (← $quoted))
+macro "pushTac" quoted:term : term => `(Bind.bind $quoted pushTactic)
 
 syntax:max "pushCom" interpolatedStr(term) : term
 
diff --git a/Verbose/Tactics/Common.lean b/Verbose/Tactics/Common.lean
index f365fff..b5c1c62 100644
--- a/Verbose/Tactics/Common.lean
+++ b/Verbose/Tactics/Common.lean
@@ -459,7 +459,10 @@ def tryGcongrComputeLemmas : TacticM Bool := withMainContext do
   trace[Verbose] s!"Will now try simplifying using gcongr and anonymous compute lemmas: {lemmas}.
 Goal is\n{← ppGoal g}"
   let goals ← try
-    let (_, unsolvedGoalStates) ← g.gcongr none |>.run (sideGoalDischarger := gcongrDischarger) (mainGoalDischarger := fun g ↦ g.gcongrForward #[])
+    -- Mathlib v4.34: `GCongrM.run` returns the whole `GCongr.State`; its `newGoals` are the
+    -- unsolved goals the 4.31 API returned.
+    let (_, gcongrState) ← g.gcongr none |>.run (sideGoalDischarger := gcongrDischarger) (mainGoalDischarger := fun g ↦ g.gcongrForward #[])
+    let unsolvedGoalStates := gcongrState.newGoals
     if unsolvedGoalStates == #[g] then
       trace[Verbose] s!"gcongr failed. Will try lemmas directly."
       restoreState state
