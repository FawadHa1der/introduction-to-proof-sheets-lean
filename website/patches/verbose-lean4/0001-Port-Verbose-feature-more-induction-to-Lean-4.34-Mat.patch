   if let .subset _ lhs rhs:= hypType then
@@ -233,7 +236,7 @@ def helpSubset : HypHelpExt where
 register_endpoint helpSinceSubsetSuggestion (hyp x : Name) (stmt new : Term)
     (l r : Expr) (ambientTypePP : Format) : SuggestionM Unit
 
-@[hypHelp _ ⊆ _]
+@[hypHelp LE.le _ _, HasSubset.Subset _ _]
 def helpSinceSubset : HypHelpExt where
   run (goal : MVarId) (hyp : Name) (hypType : VExpr) : SuggestionM Unit := do
   if let .subset _ lhs rhs:= hypType then
@@ -631,7 +634,7 @@ def descrDirectProof : SuggestionM Unit :=
 
 register_endpoint helpSubsetGoalSuggestion (l r : Format) (xN : Name) (lT : Term) : SuggestionM Unit
 
-@[goalHelp _ ⊆ _]
+@[goalHelp LE.le _ _, HasSubset.Subset _ _]
 def helpSubsetGoal : GoalHelpExt where
   run (goal : MVarId) (g : VExpr) : SuggestionM Unit := do
     if let .subset _e lhs rhs := g then
diff --git a/Verbose/Tactics/Since.lean b/Verbose/Tactics/Since.lean
index 6c32358..de4f030 100644
--- a/Verbose/Tactics/Since.lean
+++ b/Verbose/Tactics/Since.lean
@@ -193,9 +193,11 @@ def tryRel (g : MVarId) (hyps : Array Term) : TacticM Bool := do
   -- forward-reasoning on that term) on each of the listed terms.
   let assum (g : MVarId) := g.gcongrForwardStrong hyps
   -- Time to actually run the core tactic `Lean.MVarId.gcongr`!
-  let (_, unsolvedGoalStates) ← g.gcongr none |>.run (sideGoalDischarger := gcongr_side hyps)
+  -- Mathlib v4.34: `GCongrM.run` returns the whole `GCongr.State`; its `newGoals` are the
+  -- unsolved goals the 4.31 API returned.
+  let (_, gcongrState) ← g.gcongr none |>.run (sideGoalDischarger := gcongr_side hyps)
                                             (mainGoalDischarger := assum)
-  match unsolvedGoalStates.toList with
+  match gcongrState.newGoals.toList with
   -- if all goals are solved, succeed!
   | [] => return true
   -- if not, fail and report the unsolved goals
diff --git a/Verbose/Tactics/Statements.lean b/Verbose/Tactics/Statements.lean
index 875813a..28ec114 100644
--- a/Verbose/Tactics/Statements.lean
+++ b/Verbose/Tactics/Statements.lean
@@ -52,7 +52,8 @@ deriving TypeName
 
 open Language in
 instance : ToSnapshotTree SimpleMacroExpandedSnapshot where
-  toSnapshotTree s := ⟨s.toSnapshot, #[s.next.map (sync := true) toSnapshotTree]⟩
+  -- Lean 4.34: snapshot trees are built in `ToSnapshotTreeM` (as core's `MacroExpandedSnapshot`).
+  toSnapshotTreeM s := return ⟨← s.toSnapshot.transform, #[← s.next.transform]⟩
 
 syntax (name := withoutSuggestions) "without_suggestions" tacticSeq : tactic
 
