{
  "name": "proof-sheets-site",
  "private": true,
  "version": "0.1.0",
  "description": "The proof sheets of 'Bewijzen in de Wiskunde' in the browser: the Waterproof editor on Lean 4.34 compiled to WebAssembly (QED64).",
  "license": "LGPL-2.1-only",
  "type": "module",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "dev": "node scripts/stage.mjs && vite",
    "build:site": "node scripts/stage.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" \"test/*.test.mjs\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.1",
    "@codemirror/commands": "6.6.2",
    "@codemirror/language": "6.12.2",
    "@codemirror/lint": "6.9.2",
    "@codemirror/state": "6.5.3",
    "@codemirror/view": "6.38.8",
    "@impermeable/codemirror-lang-verbose": "github:impermeable/codemirror-lang-verbose#e785936aaa3a607c09a8b4f5a41a4cecf8e07cd9",
    "@impermeable/waterproof-editor": "0.18.1",
    "@leanprover/infoview": "0.11.1",
    "@leanprover/infoview-api": "0.11.0",
    "qed64": "github:FawadHa1der/QED64#8c461a869b03388c12d7ff68d83a4c621cfb728c",
    "vscode-jsonrpc": "8.2.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
